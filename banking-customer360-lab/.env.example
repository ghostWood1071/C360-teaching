# Project and network
COMPOSE_PROJECT_NAME=customer360
DOCKER_NETWORK_NAME=customer360-network

# Pinned component versions
POSTGRES_VERSION=16.6-bookworm
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
HIVE_VERSION=3.1.3
SPARK_VERSION=3.5.6
DELTA_VERSION=3.2.0
TRINO_VERSION=484
AIRFLOW_VERSION=2.10.5
AIRFLOW_DOCKER_PROVIDER_VERSION=4.0.0
RANGER_IMAGE=apache/ranger:2.7.0
SOLR_VERSION=9.8.1
POSTGRES_JDBC_VERSION=42.7.4
MYSQL_JDBC_VERSION=8.4.0
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

# PostgreSQL. setup.sh replaces all CHANGE_ME values in the local .env.
POSTGRES_ADMIN_USER=platform_db_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_app
AIRFLOW_DB_PASSWORD=CHANGE_ME_AIRFLOW_DB_PASSWORD
METASTORE_DB_NAME=metastore
METASTORE_DB_USER=metastore_app
METASTORE_DB_PASSWORD=CHANGE_ME_METASTORE_DB_PASSWORD
RANGER_DB_NAME=ranger
RANGER_DB_USER=ranger_app
RANGER_DB_PASSWORD=CHANGE_ME_RANGER_DB_PASSWORD
CORE_BANKING_DB_NAME=core_banking
CORE_BANKING_DB_USER=core_banking_app
CORE_BANKING_DB_PASSWORD=CHANGE_ME_CORE_BANKING_DB_PASSWORD
CRM_DB_NAME=crm
CRM_DB_USER=crm_app
CRM_DB_PASSWORD=CHANGE_ME_CRM_DB_PASSWORD

# MinIO root is bootstrap-only. Spark and Trino use separate identities.
MINIO_ROOT_USER=platform_root
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
SPARK_S3_ACCESS_KEY=spark_etl
SPARK_S3_SECRET_KEY=CHANGE_ME_SPARK_S3_SECRET_KEY
TRINO_S3_ACCESS_KEY=trino_reader
TRINO_S3_SECRET_KEY=CHANGE_ME_TRINO_S3_SECRET_KEY
PLATFORM_S3_ACCESS_KEY=platform_admin
PLATFORM_S3_SECRET_KEY=CHANGE_ME_PLATFORM_S3_SECRET_KEY
MINIO_REGION=us-east-1

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=CHANGE_ME_AIRFLOW_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_AIRFLOW_WEBSERVER_SECRET_KEY
AIRFLOW_UID=50000
SPARK_TASK_POOL_SLOTS=1

# Authenticated Trino identities. Passwords are written to an ignored PBKDF2 file.
TRINO_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_TRINO_PLATFORM_ADMIN_PASSWORD
TRINO_DATA_ENGINEER_PASSWORD=CHANGE_ME_TRINO_DATA_ENGINEER_PASSWORD
TRINO_RISK_ANALYST_PASSWORD=CHANGE_ME_TRINO_RISK_ANALYST_PASSWORD
TRINO_MARKETING_ANALYST_PASSWORD=CHANGE_ME_TRINO_MARKETING_ANALYST_PASSWORD
TRINO_EXTERNAL_USER_PASSWORD=CHANGE_ME_TRINO_EXTERNAL_USER_PASSWORD

# Ranger
RANGER_ADMIN_USER=admin
RANGER_ADMIN_PASSWORD=CHANGE_ME_RANGER_ADMIN_PASSWORD
RANGER_SERVICE_NAME=customer360-trino
RANGER_POLICY_POLL_MS=30000
RANGER_AUDIT_SOLR_ENABLED=false

# Spark runtime profiles
SPARK_RESOURCE_PROFILE=standard
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=2g
SPARK_CONTAINER_MEMORY=4g
SPARK_CPUS=4
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOW_MASTER=local[2]
SPARK_LOW_DRIVER_MEMORY=1g
SPARK_LOW_CONTAINER_MEMORY=2560m
SPARK_LOW_CPUS=2
SPARK_LOW_SHUFFLE_PARTITIONS=4
SPARK_EVENTS_VOLUME=customer360-spark-events
SPARK_JOBS_VOLUME=customer360-spark-jobs
SPARK_IMAGE=customer360-spark:3.5.6-delta-3.2.0
SPARK_JOB_TIMEOUT_SECONDS=1800
SPARK_EVENT_LOG_MAX_AGE=7d

# JVM and container budgets
HIVE_HEAP_SIZE=512m
HIVE_CONTAINER_MEMORY=1g
TRINO_HEAP_SIZE=1536M
TRINO_CONTAINER_MEMORY=2304m
TRINO_QUERY_MAX_MEMORY=768MB
TRINO_QUERY_MAX_TOTAL_MEMORY=1GB
TRINO_QUERY_MAX_RUN_TIME=10m
RANGER_HEAP_SIZE=768m
RANGER_CONTAINER_MEMORY=1536m
HISTORY_HEAP_SIZE=384m
HISTORY_CONTAINER_MEMORY=768m
POSTGRES_CONTAINER_MEMORY=768m
MINIO_CONTAINER_MEMORY=768m
AIRFLOW_SCHEDULER_MEMORY=1g
AIRFLOW_WEBSERVER_MEMORY=1g

# Named volumes used by Compose and ephemeral DockerOperator containers
POSTGRES_VOLUME=customer360-postgres
MINIO_VOLUME=customer360-minio
AIRFLOW_LOGS_VOLUME=customer360-airflow-logs
RANGER_AUDIT_VOLUME=customer360-ranger-audit
SOLR_VOLUME=customer360-solr

# Host interfaces and ports
HOST_BIND=127.0.0.1
AIRFLOW_PORT=8083
TRINO_HTTP_PORT=8084
TRINO_HTTPS_PORT=8443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RANGER_PORT=6080
SPARK_HISTORY_PORT=18080
SOLR_PORT=8983

# Optional source databases
CREATE_SOURCE_DATABASES=false

# Local TLS material generated by setup.sh
TRINO_KEYSTORE_PASSWORD=CHANGE_ME_TRINO_KEYSTORE_PASSWORD
TRINO_INTERNAL_SHARED_SECRET=CHANGE_ME_TRINO_INTERNAL_SHARED_SECRET
