{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::warehouse"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::warehouse/bronze/*", "arn:aws:s3:::warehouse/silver/*", "arn:aws:s3:::warehouse/quality/*", "arn:aws:s3:::warehouse/gold/*", "arn:aws:s3:::warehouse/lab/*", "arn:aws:s3:::warehouse/labs/*", "arn:aws:s3:::warehouse/smoke_test/*"]
    }
  ]
}
